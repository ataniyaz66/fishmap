# FishMap Monorepo Environment Variables Reference
# Copy the respective .env.example files into each service directory or use this root file as reference.

# Global / Infrastructure
NODE_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Service Ports & Gateway Routing
GATEWAY_PORT=4000
AUTH_PORT=4001
USERS_PORT=4002
FISHING_PORT=4003
INVENTORY_PORT=4004
SOCIAL_PORT=4005
CHAT_PORT=4006
WEATHER_PORT=4007
AI_PORT=4008

# Gateway Upstream Targets
AUTH_SERVICE_URL=http://localhost:4001
USERS_SERVICE_URL=http://localhost:4002
FISHING_SERVICE_URL=http://localhost:4003
INVENTORY_SERVICE_URL=http://localhost:4004
SOCIAL_SERVICE_URL=http://localhost:4005
CHAT_SERVICE_URL=http://localhost:4006
WEATHER_SERVICE_URL=http://localhost:4007
AI_SERVICE_URL=http://localhost:4008

# JWT Authentication
JWT_ACCESS_SECRET=your-access-secret-key-at-least-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-key-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Database Connection URLs (Host port 5434 for local dev, 5432 within Docker network)
AUTH_DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5434/fishmap_auth
USERS_DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5434/fishmap_users
FISHING_DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5434/fishmap_fishing
INVENTORY_DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5434/fishmap_inventory
SOCIAL_DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5434/fishmap_social
CHAT_DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5434/fishmap_chat

# External Providers & AI
WEATHER_PROVIDER=open-meteo
WEATHER_CACHE_TTL_MINUTES=30
AI_PROVIDER=auto
GEMINI_API_KEY=your-gemini-api-key-here
