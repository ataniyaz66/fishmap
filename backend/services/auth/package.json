{
  "name": "auth",
  "version": "1.0.0",
  "description": "FishMap Auth Service",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate --config src/config/database.js --migrations-path src/database/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/database.js --migrations-path src/database/migrations",
    "db:migrate:status": "sequelize-cli db:migrate:status --config src/config/database.js --migrations-path src/database/migrations"
  },
