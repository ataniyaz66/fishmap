PORT=4001
NODE_ENV=development
AUTH_DATABASE_URL=postgresql://fishmap_auth:fishmap_auth_dev_password@localhost:5434/fishmap_auth

# JWT Configuration
JWT_ACCESS_SECRET=your-access-secret-key-at-least-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-key-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# PostgreSQL container reference
POSTGRES_USER=fishmap_auth
POSTGRES_PASSWORD=fishmap_auth_dev_password
POSTGRES_DB=fishmap_auth
POSTGRES_PORT=5434
