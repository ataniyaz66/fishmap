# ==============================================================================
# FishMap Monorepo Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Sensitive Files
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Cryptographic Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials.json
service-account*.json

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
.npm
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# Flutter & Dart
# ------------------------------------------------------------------------------
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.ephemeral
*.gen.dart

# Flutter Android
android/.gradle/
android/local.properties
android/key.properties
android/captures/

# Flutter iOS & macOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.framework
macos/Pods/
macos/.symlinks/
macos/Flutter/ephemeral/

# Flutter Desktop
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# ------------------------------------------------------------------------------
# Build & Test Artifacts
# ------------------------------------------------------------------------------
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Logs & Process Output
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Temporary Files & User Uploads
# ------------------------------------------------------------------------------
tmp/
temp/
backend/services/social/public/uploads/*
!backend/services/social/public/uploads/.gitkeep
!backend/services/social/public/uploads/.gitignore
