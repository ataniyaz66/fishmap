@startuml use-case
title FishMap - Use Case Diagram
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "Angler" as A
actor "Weather service" as W
actor "AI module" as AI

rectangle "FishMap" {
  usecase "Register / log in" as UC1
  usecase "Manage profile" as UC2
  usecase "View interactive map" as UC3
  usecase "Add fishing spot" as UC4
  usecase "Add catch with photo" as UC5
  usecase "Get species suggestion\nfrom photo" as UC6
  usecase "Manage equipment inventory" as UC7
  usecase "Set privacy of spots\nand inventory" as UC8
  usecase "Find anglers and\nmanage friends" as UC9
  usecase "View statistics and\nfishing journal" as UC10
  usecase "View weather for\nspot and time" as UC11
  usecase "Get personalized\nrecommendations" as UC12
  usecase "Receive notifications" as UC13
}

A --> UC1
A --> UC2
A --> UC3
A --> UC4
A --> UC5
A --> UC7
A --> UC9
A --> UC10
A --> UC11
A --> UC12
A --> UC13

UC6 .> UC5 : <<extend>>
UC8 .> UC4 : <<extend>>
UC8 .> UC7 : <<extend>>
UC4 ..> UC3 : <<include>>

UC6 -- AI
UC12 -- AI
UC11 -- W
@enduml
